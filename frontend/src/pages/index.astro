---
// Pulls one article from Drupal through the custom GraphQL 4 schema.
const endpoint = import.meta.env.DRUPAL_GRAPHQL ?? 'http://drupal-article-demo.ddev.site/graphql';
const id = Number(import.meta.env.ARTICLE_ID ?? 1);

const query = `
  query Article($id: Int!) {
    article(id: $id) {
      title
      teaser
      metaDescription
      body
      image { url alt }
      sections { id type text }
    }
  }
`;

let article = null;
let error = null;
try {
  const res = await fetch(endpoint, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query, variables: { id } }),
  });
  const json = await res.json();
  article = json.data?.article ?? null;
  error = json.errors?.[0]?.message ?? null;
} catch (e) {
  error = String(e);
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{article?.title ?? 'Article'}</title>
    {article?.metaDescription && <meta name="description" content={article.metaDescription} />}
    <style>
      body { font-family: Georgia, serif; max-width: 42rem; margin: 3rem auto; padding: 0 1rem; line-height: 1.6; color: #222; }
      .teaser { font-size: 1.2rem; color: #555; }
      img { max-width: 100%; height: auto; border-radius: 6px; }
      .seo { font-family: system-ui, sans-serif; font-size: .85rem; background: #f4f4f4; padding: .75rem 1rem; border-radius: 6px; margin-top: 2rem; }
    </style>
  </head>
  <body>
    {error && <p>Could not load article: {error}</p>}
    {article && (
      <article>
        <h1>{article.title}</h1>
        <p class="teaser">{article.teaser}</p>
        {article.image?.url && <img src={article.image.url} alt={article.image.alt ?? ''} />}
        <div set:html={article.body} />
        {article.sections?.map((s) => <section set:html={s.text} />)}
        <p class="seo"><strong>SEO description from Drupal:</strong> {article.metaDescription}</p>
      </article>
    )}
  </body>
</html>
